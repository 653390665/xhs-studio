# Copy to .env and fill in your own values. Never commit the real file.

# Discovery / crawler data source:
#   pc      = use your own XHS account cookie (free, default)
#   redfox  = RedFox read-only API (paid, no XHS account needed)
XHS_DATA_PROVIDER=pc

# Optional: RedFox API key (only needed for rankings / hot topics / sensitive words)
REDFOX_API_KEY=

# Security. Source/package launchers generate a persistent per-install secret;
# set these only when you need to supply your own (both must be non-placeholder).
# SECRET_KEY=change-me-to-a-long-random-string
# FERNET_KEY=change-me-to-a-valid-fernet-key
# Optional overrides
# DATABASE_SQLITE_PATH=./data/spider_xhs.db
# XHS_STORAGE_DIR=./backend/app/storage
# FRONTEND_SERVE_STATIC=false

# Scheduled publishing.
#   false (default) = nothing runs at the scheduled time; you publish by hand.
#   true            = a background job checks every SCHEDULER_INTERVAL_SECONDS and
#                     publishes due jobs for real, to the live XHS account.
# This posts content without a human in the loop. Leave it off until you have
# published a few times manually and trust the preflight checks.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Optional: pin FFmpeg binaries (recommended when PATH has an old build)
# DOUYIN_EXTRACT_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# DOUYIN_EXTRACT_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# Optional: pin the transcription model / device
# DOUYIN_EXTRACT_WHISPER_MODEL=small
# DOUYIN_EXTRACT_WHISPER_DEVICE=cpu
